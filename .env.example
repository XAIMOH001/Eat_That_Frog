# Copy to .env.local and fill in. Never commit real values.

# Postgres connection string.
DATABASE_URL=postgres://user:password@localhost:5432/eat_that_frog

# Session signing key, 32+ characters. Generate one with: bunx auth@latest secret
BETTER_AUTH_SECRET=

# The app's own origin. Used to sign cookies and to resolve redirects and OG URLs.
BETTER_AUTH_URL=http://localhost:3000

# Seals the user's chosen private commitment. 32 bytes, base64.
# Generate with: openssl rand -base64 32
COMMITMENT_SECRET_KEY=
